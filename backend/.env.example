# ==========================================
# Nayaruvi Pulse Backend - Environment Variables
# Copy these values into Render.com -> Environment Variables
# ==========================================

# Port (Render will automatically set PORT, defaults to 5000 locally)
PORT=5000

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL="https://pulsenayaruvi-default-rtdb.asia-southeast1.firebasedatabase.app"

# Frontend Application URL (Used for generating invite links)
# Update this with your live frontend URL (e.g. https://pulsenayaruvi.web.app or https://pulse-nayaruvi.vercel.app)
FRONTEND_URL="https://pulsenayaruvi.web.app"

# ==========================================
# Email Configuration (Nodemailer / SMTP)
# ==========================================
# Gmail Setup:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and App Password below (spaces are automatically stripped):
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"

# Custom SMTP (Optional - leave blank if using standard Gmail):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false

# ==========================================
# Firebase Admin Credentials (Optional on Render)
# ==========================================
# If you want full admin rights on RTDB, paste your entire serviceAccountKey.json content
# as a single-line JSON string into FIREBASE_SERVICE_ACCOUNT in Render.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
